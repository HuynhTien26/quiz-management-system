USE QL_ThiTracNghiem;
GO

IF OBJECT_ID('Tham_So', 'U') IS NULL
BEGIN
    CREATE TABLE Tham_So (
        Ma_So   VARCHAR(50)   PRIMARY KEY,
        Gia_Tri NVARCHAR(255) NOT NULL
    );
END
GO

IF NOT EXISTS (SELECT 1 FROM Tham_So WHERE Ma_So = 'THANG_DIEM')
    INSERT INTO Tham_So (Ma_So, Gia_Tri) VALUES ('THANG_DIEM', N'10');

IF NOT EXISTS (SELECT 1 FROM Tham_So WHERE Ma_So = 'DIEM_DAT')
    INSERT INTO Tham_So (Ma_So, Gia_Tri) VALUES ('DIEM_DAT', N'5');

IF NOT EXISTS (SELECT 1 FROM Tham_So WHERE Ma_So = 'THOI_GIAN_MAC_DINH')
    INSERT INTO Tham_So (Ma_So, Gia_Tri) VALUES ('THOI_GIAN_MAC_DINH', N'45');
GO
