@page
@using System.Data
@model QL_Thi_Trac_Nghiem.Pages.ExamConfig.MaTranDeModel
@{
    ViewData["Title"] = "Thiết lập Ma trận Đề thi";
}

<h2>Thiết lập Ma trận Đề thi</h2>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-warning")" role="alert">
        @Model.StatusMessage
    </div>
}

<form method="post" asp-page-handler="Save" class="mb-4" id="frmMaTran">
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="MaMT" class="form-label">Mã ma trận</label>
            <input asp-for="MaMT" id="txtMaMT" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label asp-for="MaMon" class="form-label">Môn học</label>
            <select asp-for="MaMon" id="cboMon" asp-items="Model.MonHocOptions" class="form-select" required>
                <option value="">-- Chọn môn học --</option>
            </select>
        </div>
        <div class="col-md-5 d-flex align-items-end">
            <span id="lblTongTyLe" class="fw-bold text-danger">Tổng tỷ lệ: 0%</span>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-3">
            <label asp-for="TyLeCoBan" class="form-label">% Cơ bản</label>
            <input asp-for="TyLeCoBan" id="numCoBan" type="number" min="0" max="100" step="1" class="form-control" placeholder="Nhập %" required />
        </div>
        <div class="col-md-3">
            <label asp-for="TyLeVanDung" class="form-label">% Vận dụng</label>
            <input asp-for="TyLeVanDung" id="numVanDung" type="number" min="0" max="100" step="1" class="form-control" placeholder="Nhập %" required />
        </div>
        <div class="col-md-3">
            <label asp-for="TyLeVDNangCao" class="form-label">% Vận dụng cao</label>
            <input asp-for="TyLeVDNangCao" id="numVDNangCao" type="number" min="0" max="100" step="1" class="form-control" placeholder="Nhập %" required />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" id="btnLuuMaTran" class="btn btn-primary" disabled>Lưu</button>
        <a asp-page="/ExamConfig/MaTranDe" id="btnTaoMoi" class="btn btn-secondary">Tạo mới</a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã ma trận</th>
            <th>Môn học</th>
            <th>% Cơ bản</th>
            <th>% Vận dụng</th>
            <th>% Vận dụng cao</th>
            <th style="width: 170px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (DataRow row in Model.DanhSachMaTran.Rows)
        {
            var maMT = row["Ma_MT"]?.ToString() ?? "";
            <tr>
                <td>@maMT</td>
                <td>@(row["Ten_mon"]?.ToString() ?? row["Ma_Mon"]?.ToString() ?? "")</td>
                <td>@(row["Ty_le_co_ban"]?.ToString() ?? "0")%</td>
                <td>@(row["Ty_le_van_dung"]?.ToString() ?? "0")%</td>
                <td>@(row["Ty_le_vd_nang_cao"]?.ToString() ?? "0")%</td>
                <td>
                    <a asp-page="/ExamConfig/MaTranDe" asp-route-editMaMT="@maMT" class="btn btn-sm btn-outline-primary">Chọn</a>
                    <form method="post" asp-page-handler="Delete" asp-route-maMT="@maMT" class="d-inline"
                          onsubmit="return confirm('Xóa ma trận @maMT?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        (function () {
            const maMT = document.getElementById("txtMaMT");
            const mon = document.getElementById("cboMon");
            const cb = document.getElementById("numCoBan");
            const vd = document.getElementById("numVanDung");
            const vdnc = document.getElementById("numVDNangCao");
            const lbl = document.getElementById("lblTongTyLe");
            const btn = document.getElementById("btnLuuMaTran");
            const btnTaoMoi = document.getElementById("btnTaoMoi");

            function capNhatTong() {
                const duCaBa = cb.value.trim() !== "" && vd.value.trim() !== "" && vdnc.value.trim() !== "";
                const tong = (parseFloat(cb.value) || 0) + (parseFloat(vd.value) || 0) + (parseFloat(vdnc.value) || 0);
                const hopLe = duCaBa && Math.abs(tong - 100) < 0.001;

                lbl.textContent = `Tổng tỷ lệ: ${tong}%`;
                lbl.className = hopLe ? "fw-bold text-success" : "fw-bold text-danger";
                btn.disabled = !hopLe;
            }

            [cb, vd, vdnc].forEach(el => el && el.addEventListener("input", capNhatTong));

            // Xóa trắng ngay cả 3 ô % khi bấm nút Tạo mới
            if (btnTaoMoi) {
                btnTaoMoi.addEventListener("click", function () {
                    maMT.value = "";
                    mon.value = "";
                    cb.value = "";
                    vd.value = "";
                    vdnc.value = "";
                    capNhatTong();
                });
            }

            capNhatTong();
        })();
    </script>
}