@page
@using System.Data
@model QL_Thi_Trac_Nghiem.Pages.ExamConfig.KyThiModel
@{
    ViewData["Title"] = "Quản lý Kỳ thi";
}

<h2>Quản lý Kỳ thi</h2>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-warning")" role="alert">
        @Model.StatusMessage
    </div>
}

<form method="post" asp-page-handler="Save" class="mb-4">
    <input type="hidden" asp-for="IsEdit" />
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="MaKT" class="form-label">Mã kỳ thi</label>
            @if (Model.IsEdit)
            {
                <input asp-for="MaKT" class="form-control" readonly />
            }
            else
            {
                <input asp-for="MaKT" class="form-control" required />
            }
        </div>
        <div class="col-md-5">
            <label asp-for="Ten" class="form-label">Tên kỳ thi</label>
            <input asp-for="Ten" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label asp-for="NgayThi" class="form-label">Ngày thi</label>
            <input asp-for="NgayThi" type="date" class="form-control" required />
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-page="/ExamConfig/KyThi" class="btn btn-secondary">Tạo mới</a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã kỳ thi</th>
            <th>Tên kỳ thi</th>
            <th>Ngày thi</th>
            <th style="width: 170px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (DataRow row in Model.DanhSachKyThi.Rows)
        {
            var ma = row["Ma_KT"]?.ToString() ?? "";
            <tr>
                <td>@ma</td>
                <td>@(row["Ten"]?.ToString() ?? "")</td>
                <td>
                    @if (DateTime.TryParse(row["Ngay_thi"]?.ToString(), out DateTime dt))
                    {
                        @dt.ToString("dd/MM/yyyy")
                    }
                </td>
                <td>
                    <a asp-page="/ExamConfig/KyThi" asp-route-editMaKT="@ma" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form method="post" asp-page-handler="Delete" asp-route-maKT="@ma" class="d-inline"
                          onsubmit="return confirm('Xóa kỳ thi @ma?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
