@page
@using System.Data
@model QL_Thi_Trac_Nghiem.Pages.ExamConfig.TaoDeThiModel
@{
    ViewData["Title"] = "Tạo Đề thi";
}

<h2>Tạo Đề thi</h2>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-warning")" role="alert">
        @Model.StatusMessage
    </div>
}

<form method="post" asp-page-handler="SinhDe">
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="MaDe" class="form-label">Mã đề</label>
            <input asp-for="MaDe" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label asp-for="MaKT" class="form-label">Kỳ thi</label>
            <select asp-for="MaKT" asp-items="Model.KyThiOptions" class="form-select" required></select>
        </div>
        <div class="col-md-3">
            <label asp-for="MaMT" class="form-label">Ma trận</label>
            <select asp-for="MaMT" asp-items="Model.MaTranOptions" class="form-select" required></select>
        </div>
        <div class="col-md-3">
            <label asp-for="MaMon" class="form-label">Môn học</label>
            <select asp-for="MaMon" asp-items="Model.MonHocOptions" class="form-select" required></select>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-3">
            <label asp-for="MaGV" class="form-label">Mã giảng viên</label>
            <input asp-for="MaGV" class="form-control" required />
        </div>
        <div class="col-md-2">
            <label asp-for="SoLuongCH" class="form-label">Số câu hỏi</label>
            <input asp-for="SoLuongCH" type="number" min="1" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="ThoiGianLamBai" class="form-label">Thời gian (phút)</label>
            <input asp-for="ThoiGianLamBai" type="number" min="1" class="form-control" />
        </div>
        <div class="col-md-1">
            <label asp-for="TyLeCoBan" class="form-label">% CB</label>
            <input asp-for="TyLeCoBan" type="number" min="0" max="100" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="TyLeVanDung" class="form-label">% VD</label>
            <input asp-for="TyLeVanDung" type="number" min="0" max="100" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="TyLeVDNangCao" class="form-label">% VD cao</label>
            <input asp-for="TyLeVDNangCao" type="number" min="0" max="100" class="form-control" />
        </div>
    </div>

    <h5 class="mt-4">Chọn tay câu hỏi vào CT_DT (để trống nếu muốn sinh ngẫu nhiên theo ma trận)</h5>
    <div class="border p-2" style="max-height: 240px; overflow-y: auto;">
        @foreach (DataRow ch in Model.DanhSachCauHoi.Rows)
        {
            var maCH = ch["Ma_CH"]?.ToString() ?? "";
            var mucDo = ch["Muc_do"]?.ToString() ?? "";
            var noiDung = ch["Noi_dung"]?.ToString() ?? "";
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="DanhSachChonTay" value="@maCH" id="ch_@maCH" />
                <label class="form-check-label" for="ch_@maCH">
                    <strong>@maCH</strong> [@mucDo] - @noiDung
                </label>
            </div>
        }
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Sinh đề thi</button>
    </div>
</form>
