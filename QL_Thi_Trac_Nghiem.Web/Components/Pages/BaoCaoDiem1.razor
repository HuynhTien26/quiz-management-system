@page "/bao-cao-diem"
@rendermode InteractiveServer
@using System.Globalization
@using System.Text
@inject IJSRuntime JS
@using QL_Thi_Trac_Nghiem.Web.Services
@inject PhienDangNhapService PhienDN
@inject NavigationManager NavManager

<PageTitle>Thống kê & Báo cáo Điểm thi</PageTitle>

<div class="exam-report-page">
    <!-- Header -->
    <div class="report-header">
        <div>
            <span class="badge-pill">QL_Thi_Trac_Nghiem • Blazor UI</span>
            <h1>Thống kê &amp; Báo cáo Điểm thi</h1>
            <p class="subtitle">Tổng hợp kết quả theo thời gian, tỷ lệ đạt/chưa đạt, 3 bảng thống kê theo Quý (Q1–Q4) và xuất CSV/PDF.</p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button class="btn-export" @onclick="XuatFileCsv">
                <span>⬇</span>
                <span>Xuất báo cáo (.CSV)</span>
            </button>
            <button class="btn-export btn-export-pdf" @onclick="XuatFilePdf">
                <span>📄</span>
                <span>Xuất báo cáo (.PDF)</span>
            </button>
        </div>
    </div>

    <!-- KPI Cards (Mục 10a) -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Tổng bài đã nộp</div>
            <div class="kpi-value">@DanhSachLoc.Count</div>
            <div class="kpi-note">Đạt: <strong>@SoBaiDat</strong> • Chưa đạt: <strong class="text-danger">@SoBaiChuaDat</strong></div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Điểm trung bình</div>
            <div class="kpi-value accent-blue">@DiemTrungBinh.ToString("0.00")</div>
            <div class="kpi-note">Thang điểm 10</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Tỷ lệ đạt (&ge; 5.0)</div>
            <div class="kpi-value accent-green">@TyLeDat.ToString("0.#")%</div>
            <div class="kpi-note">@SoBaiDat / @DanhSachLoc.Count bài đạt</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Điểm cao nhất</div>
            <div class="kpi-value accent-purple">@DiemCaoNhat.ToString("0.00")</div>
            <div class="kpi-note">Cập nhật theo bộ lọc</div>
        </div>
    </div>

    <!-- Filter Bar (2 hàng: Học vụ + Thời gian Mục 10a) -->
    <div class="filter-card">
        <div class="filter-row">
            <div class="filter-group">
                <label>Kỳ thi</label>
                <select @bind="KyThiChon">
                    <option value="Tất cả">Tất cả kỳ thi</option>
                    @foreach (var kt in DanhSachKyThi)
                    {
                        <option value="@kt">@kt</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Môn học</label>
                <select @bind="MonHocChon">
                    <option value="Tất cả">Tất cả môn học</option>
                    @foreach (var mh in DanhSachMonHoc)
                    {
                        <option value="@mh">@mh</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Lớp sinh viên</label>
                <select @bind="LopChon">
                    <option value="Tất cả">Tất cả lớp</option>
                    @foreach (var lp in DanhSachLop)
                    {
                        <option value="@lp">@lp</option>
                    }
                </select>
            </div>
            <div class="filter-group filter-search">
                <label>Tìm mã SV / Họ tên / GV</label>
                <input type="text" @bind="TuKhoaTimKiem" @bind:event="oninput" placeholder="VD: SV01, Nguyễn Văn An, GV01..." />
            </div>
            <div class="filter-actions">
                <button class="btn-reset" @onclick="DatLaiBoLoc">Đặt lại</button>
            </div>
        </div>

        <div class="filter-divider"></div>

        <div class="filter-row">
            <div class="filter-group">
                <label>Lọc thời gian (Mục 10a)</label>
                <select @bind="CheDoThoiGian">
                    <option value="Tất cả">Tất cả thời gian</option>
                    <option value="KhoangNgay">Từ ngày → Đến ngày</option>
                    <option value="Thang">Theo Tháng</option>
                    <option value="Quy">Theo Quý</option>
                    <option value="Nam">Theo Năm</option>
                </select>
            </div>

            @if (CheDoThoiGian == "KhoangNgay")
            {
                <div class="filter-group">
                    <label>Từ ngày</label>
                    <input type="date" @bind="TuNgay" />
                </div>
                <div class="filter-group">
                    <label>Đến ngày</label>
                    <input type="date" @bind="DenNgay" />
                </div>
            }
            else if (CheDoThoiGian == "Thang")
            {
                <div class="filter-group">
                    <label>Chọn Tháng</label>
                    <select @bind="ThangChon">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">Tháng @m</option>
                        }
                    </select>
                </div>
            }
            else if (CheDoThoiGian == "Quy")
            {
                <div class="filter-group">
                    <label>Chọn Quý</label>
                    <select @bind="QuyChon">
                        @for (int q = 1; q <= 4; q++)
                        {
                            <option value="@q">Quý @q</option>
                        }
                    </select>
                </div>
            }

            <div class="filter-group">
                <label>Năm (lọc &amp; 3 bảng Quý)</label>
                <input type="number" min="2020" max="2100" @bind="NamChon" />
            </div>

            <div class="filter-group">
                <label>Chỉ số 3 bảng Quý</label>
                <select @bind="CheDoBangQuy">
                    <option value="SoLuong">Số lượng bài thi</option>
                    <option value="DiemTB">Điểm trung bình</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Tabs & Data Tables -->
    <div class="table-card">
        <div class="tabs-bar">
            <button class="tab-btn @(TabDangChon == 1 ? "active" : "")" @onclick="() => TabDangChon = 1">
                1. Chi tiết Điểm thi (@DanhSachLoc.Count)
            </button>
            <button class="tab-btn @(TabDangChon == 2 ? "active" : "")" @onclick="() => TabDangChon = 2">
                2. Theo Môn học &amp; Quý (Q1–Q4)
            </button>
            <button class="tab-btn @(TabDangChon == 3 ? "active" : "")" @onclick="() => TabDangChon = 3">
                3. Theo Lớp SV &amp; Quý (Q1–Q4)
            </button>
            <button class="tab-btn @(TabDangChon == 4 ? "active" : "")" @onclick="() => TabDangChon = 4">
                4. Theo Giảng viên &amp; Quý (Q1–Q4)
            </button>
        </div>

        @if (TabDangChon == 1)
        {
            <div class="table-toolbar">
                <h3>Danh sách kết quả thi chi tiết</h3>
                <span class="result-count">Hiển thị <strong>@DanhSachLoc.Count</strong> bản ghi</span>
            </div>

            <div class="table-responsive">
                <table class="score-table">
                    <thead>
                        <tr>
                            <th>Mã bài thi</th>
                            <th>Sinh viên</th>
                            <th>Lớp</th>
                            <th>Môn học &amp; Giảng viên</th>
                            <th>Kỳ thi</th>
                            <th>Ngày thi</th>
                            <th class="text-center">Đúng / Sai</th>
                            <th class="text-right">Tổng điểm</th>
                            <th class="text-center">Xếp loại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (DanhSachLoc.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="empty-row">Không có dữ liệu điểm thi phù hợp với bộ lọc hiện tại.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in DanhSachLoc)
                            {
                                bool dat = item.TongDiem >= 5.0;
                                <tr>
                                    <td class="mono">@item.MaBT</td>
                                    <td>
                                        <div class="student-name">@item.HoTenSV</div>
                                        <div class="student-code">@item.MaSV • Đề @item.MaDe</div>
                                    </td>
                                    <td><span class="chip">@item.Lop</span></td>
                                    <td>
                                        <div class="student-name">@item.TenMon</div>
                                        <div class="student-code">@item.GiangVien</div>
                                    </td>
                                    <td>@item.KyThi (@item.NamHoc)</td>
                                    <td class="mono">@item.NgayThi.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <span class="stat-ok">@item.SoCauDung đúng</span>
                                        <span class="stat-sep">/</span>
                                        <span class="stat-bad">@item.SoCauSai sai</span>
                                    </td>
                                    <td class="text-right">
                                        <span class="score-pill @(dat ? "score-pass" : "score-fail")">
                                            @item.TongDiem.ToString("0.00")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="status-badge @(dat ? "badge-pass" : "badge-fail")">
                                            @(dat ? "Đạt" : "Chưa đạt")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            var duLieuQuy = LayDuLieuBangQuyHienTai();
            string tieuDeBang = TabDangChon switch
            {
                2 => $"Thống kê theo Môn học & Quý — Năm {NamChon}",
                3 => $"Thống kê theo Lớp sinh viên & Quý — Năm {NamChon}",
                _ => $"Thống kê theo Giảng viên & Quý — Năm {NamChon}"
            };
            string tenCotDau = TabDangChon switch
            {
                2 => "Môn học",
                3 => "Lớp sinh viên",
                _ => "Giảng viên"
            };

            <div class="table-toolbar">
                <h3>@tieuDeBang</h3>
                <span class="result-count">
                    Chỉ số: <strong>@(LaCheDoDiemTB ? "Điểm trung bình (thang 10)" : "Số lượng bài thi")</strong>
                </span>
            </div>

            <div class="table-responsive">
                <table class="score-table">
                    <thead>
                        <tr>
                            <th>@tenCotDau</th>
                            <th class="text-right">Q1</th>
                            <th class="text-right">Q2</th>
                            <th class="text-right">Q3</th>
                            <th class="text-right">Q4</th>
                            <th class="text-right">TC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (duLieuQuy.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="empty-row">Không có bài thi nào trong năm @NamChon để tổng hợp theo Quý.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in duLieuQuy)
                            {
                                <tr class="@(row.LaDongTong ? "total-row" : "")">
                                    <td>@row.TenDoiTuong</td>
                                    <td class="text-right mono">@DinhDangSoQuy(row.Q1)</td>
                                    <td class="text-right mono">@DinhDangSoQuy(row.Q2)</td>
                                    <td class="text-right mono">@DinhDangSoQuy(row.Q3)</td>
                                    <td class="text-right mono">@DinhDangSoQuy(row.Q4)</td>
                                    <td class="text-right mono total-col">@DinhDangSoQuy(row.TC)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .exam-report-page {
        --bg: #f4f7fb;
        --card: #ffffff;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --success-bg: #dcfce7;
        --success-text: #15803d;
        --danger-bg: #fee2e2;
        --danger-text: #b91c1c;

        font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
        background: linear-gradient(180deg, #eef4ff 0%, var(--bg) 220px);
        min-height: 100vh;
        padding: 28px;
        color: var(--text);
    }

    .report-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }

    .badge-pill {
        display: inline-block;
        background: #dbeafe;
        color: var(--primary-dark);
        font-size: 12px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 999px;
        margin-bottom: 8px;
    }

    .report-header h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .subtitle {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: 14px;
    }

    .btn-export {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 11px 18px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 8px 20px -6px rgba(37, 99, 235, 0.55);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .btn-export-pdf {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        box-shadow: 0 8px 20px -6px rgba(220, 38, 38, 0.45);
    }

    .btn-export:hover {
        transform: translateY(-1px);
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 18px;
    }

    .kpi-card, .filter-card, .table-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.05);
    }

    .kpi-card {
        padding: 18px 20px;
    }

    .kpi-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--muted);
    }

    .kpi-value {
        font-size: 28px;
        font-weight: 700;
        margin: 6px 0 4px;
    }

    .kpi-note {
        font-size: 12px;
        color: var(--muted);
    }

    .text-danger { color: #b91c1c; }
    .accent-blue { color: #2563eb; }
    .accent-green { color: #16a34a; }
    .accent-purple { color: #7c3aed; }

    .filter-card {
        padding: 16px 20px;
        margin-bottom: 18px;
    }

    .filter-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
        gap: 14px;
        align-items: end;
    }

    .filter-divider {
        height: 1px;
        background: #eef2f7;
        margin: 14px 0;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-group label {
        font-size: 12.5px;
        font-weight: 600;
        color: #334155;
    }

    .filter-group select,
    .filter-group input {
        height: 38px;
        padding: 0 12px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        font-size: 13.5px;
        color: var(--text);
        background: #fff;
        outline: none;
    }

    .filter-group select:focus,
    .filter-group input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.14);
    }

    .btn-reset {
        height: 38px;
        width: 100%;
        padding: 0 14px;
        border-radius: 9px;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-reset:hover {
        background: #f1f5f9;
    }

    .table-card {
        overflow: hidden;
    }

    .tabs-bar {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        padding: 12px 16px 0;
        background: #f8fafc;
        border-bottom: 1px solid var(--border);
    }

    .tab-btn {
        padding: 10px 16px;
        border: 1px solid transparent;
        border-bottom: none;
        border-radius: 10px 10px 0 0;
        background: transparent;
        color: #475569;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .tab-btn:hover {
        background: #eff6ff;
        color: var(--primary-dark);
    }

    .tab-btn.active {
        background: #ffffff;
        color: var(--primary-dark);
        border-color: var(--border);
        margin-bottom: -1px;
        padding-bottom: 11px;
    }

    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
        gap: 10px;
    }

    .table-toolbar h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .result-count {
        font-size: 13px;
        color: var(--muted);
    }

    .table-responsive {
        overflow-x: auto;
    }

    .score-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

    .score-table th {
        background: #f8fafc;
        color: #475569;
        font-weight: 600;
        text-align: left;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }

    .score-table td {
        padding: 13px 16px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .score-table tbody tr:hover {
        background: #f8fbff;
    }

    .total-row td {
        background: #eff6ff !important;
        color: #1e3a8a;
        font-weight: 700;
        border-top: 2px solid #bfdbfe;
    }

    .total-col {
        font-weight: 700;
        color: #1d4ed8;
    }

    .mono {
        font-family: Consolas, monospace;
        font-size: 12.5px;
        color: #334155;
    }

    .student-name {
        font-weight: 600;
        color: var(--text);
    }

    .student-code {
        font-size: 12px;
        color: var(--muted);
    }

    .chip {
        background: #f1f5f9;
        color: #334155;
        padding: 3px 9px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .stat-ok { color: #15803d; font-weight: 600; }
    .stat-bad { color: #b91c1c; font-weight: 600; }
    .stat-sep { color: #94a3b8; margin: 0 4px; }

    .score-pill {
        display: inline-block;
        min-width: 54px;
        text-align: center;
        padding: 4px 10px;
        border-radius: 8px;
        font-weight: 700;
    }

    .score-pass { background: #eff6ff; color: #1d4ed8; }
    .score-fail { background: #fef2f2; color: #b91c1c; }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-pass { background: var(--success-bg); color: var(--success-text); }
    .badge-fail { background: var(--danger-bg); color: var(--danger-text); }

    .text-center { text-align: center !important; }
    .text-right { text-align: right !important; }
    .empty-row { text-align: center; padding: 28px !important; color: var(--muted); }
</style>

@code {
    // Bộ lọc học vụ
    private string KyThiChon { get; set; } = "Tất cả";
    private string MonHocChon { get; set; } = "Tất cả";
    private string LopChon { get; set; } = "Tất cả";
    private string TuKhoaTimKiem { get; set; } = "";

    // Bộ lọc thời gian (Mục 10a) & cấu hình 3 bảng Quý
    private string CheDoThoiGian { get; set; } = "Tất cả";
    private DateTime TuNgay { get; set; } = new DateTime(DateTime.Now.Year, 1, 1);
    private DateTime DenNgay { get; set; } = DateTime.Now.Date;
    private int ThangChon { get; set; } = DateTime.Now.Month;
    private int QuyChon { get; set; } = (DateTime.Now.Month - 1) / 3 + 1;
    private int NamChon { get; set; } = DateTime.Now.Year;
    private string CheDoBangQuy { get; set; } = "SoLuong";
    private int TabDangChon { get; set; } = 1;

    private bool LaCheDoDiemTB => CheDoBangQuy == "DiemTB";

    private List<DiemThiItem> DanhSachGoc { get; set; } = new();

    protected override void OnInitialized()
    {
        int y = DateTime.Now.Year;
        // Dữ liệu mẫu đầy đủ 4 quý (Q1–Q4) để xem trực quan ngay cả 3 bảng thống kê theo Quý
        DanhSachGoc = new List<DiemThiItem>
        {
            new("BT26021501", "SV01", "Nguyễn Văn An", "DCT1231", "DE_TEST01", "Cơ sở dữ liệu", "GV01 - Nguyễn Văn An", "Học kỳ 1", "2025-2026", 4, 1, 8.0, new DateTime(y, 2, 15)),
            new("BT26031002", "SV02", "Trần Thị Bình", "DCT1232", "DE_TEST01", "Cơ sở dữ liệu", "GV01 - Nguyễn Văn An", "Học kỳ 1", "2025-2026", 2, 3, 4.0, new DateTime(y, 3, 10)),
            new("BT26051203", "SV03", "Lê Hoàng Minh", "DCT1231", "DE_CNPM01", "Công nghệ phần mềm", "GV02 - Trần Minh Tuấn", "Học kỳ 2", "2025-2026", 9, 1, 9.0, new DateTime(y, 5, 12)),
