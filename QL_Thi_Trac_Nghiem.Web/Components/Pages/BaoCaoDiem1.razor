    private IEnumerable<string> DanhSachKyThi => DanhSachGoc.Select(x => x.KyThi).Distinct().OrderBy(x => x);
    private IEnumerable<string> DanhSachMonHoc => DanhSachGoc.Select(x => x.TenMon).Distinct().OrderBy(x => x);
    private IEnumerable<string> DanhSachLop => DanhSachGoc.Select(x => x.Lop).Distinct().OrderBy(x => x);

    private List<DiemThiItem> DanhSachLoc => DanhSachGoc.Where(x =>
        (KyThiChon == "Tất cả" || x.KyThi == KyThiChon) &&
        (MonHocChon == "Tất cả" || x.TenMon == MonHocChon) &&
        (LopChon == "Tất cả" || x.Lop == LopChon) &&
        KhopThoiGian(x.NgayThi) &&
        (string.IsNullOrWhiteSpace(TuKhoaTimKiem) ||
         x.MaSV.Contains(TuKhoaTimKiem.Trim(), StringComparison.OrdinalIgnoreCase) ||
         x.HoTenSV.Contains(TuKhoaTimKiem.Trim(), StringComparison.OrdinalIgnoreCase) ||
         x.GiangVien.Contains(TuKhoaTimKiem.Trim(), StringComparison.OrdinalIgnoreCase))
    ).ToList();

    private bool KhopThoiGian(DateTime ngayThi) => CheDoThoiGian switch
    {
        "KhoangNgay" => ngayThi.Date >= TuNgay.Date && ngayThi.Date <= DenNgay.Date,
        "Thang" => ngayThi.Year == NamChon && ngayThi.Month == ThangChon,
        "Quy" => ngayThi.Year == NamChon && ((ngayThi.Month - 1) / 3 + 1) == QuyChon,
        "Nam" => ngayThi.Year == NamChon,
        _ => true
    };

    private double DiemTrungBinh => DanhSachLoc.Count == 0 ? 0 : DanhSachLoc.Average(x => x.TongDiem);
    private int SoBaiDat => DanhSachLoc.Count(x => x.TongDiem >= 5.0);
    private int SoBaiChuaDat => DanhSachLoc.Count - SoBaiDat;
    private double TyLeDat => DanhSachLoc.Count == 0 ? 0 : (double)SoBaiDat / DanhSachLoc.Count * 100.0;
    private double DiemCaoNhat => DanhSachLoc.Count == 0 ? 0 : DanhSachLoc.Max(x => x.TongDiem);

    private void DatLaiBoLoc()
    {
        KyThiChon = "Tất cả";
        MonHocChon = "Tất cả";
        LopChon = "Tất cả";
        TuKhoaTimKiem = "";
        CheDoThoiGian = "Tất cả";
        TuNgay = new DateTime(DateTime.Now.Year, 1, 1);
        DenNgay = DateTime.Now.Date;
        ThangChon = DateTime.Now.Month;
        QuyChon = (DateTime.Now.Month - 1) / 3 + 1;
        NamChon = DateTime.Now.Year;
    }

    // ==================== 3 BẢNG THỐNG KÊ THEO QUÝ (Q1 - Q4, TC) ====================

    private List<ThongKeQuyRow> LayDuLieuBangQuyHienTai() => TabDangChon switch
    {
        2 => TaoBangThongKeQuy(x => x.TenMon),
        3 => TaoBangThongKeQuy(x => x.Lop),
        4 => TaoBangThongKeQuy(x => x.GiangVien),
        _ => new List<ThongKeQuyRow>()
    };

    private List<ThongKeQuyRow> TaoBangThongKeQuy(Func<DiemThiItem, string> chonNhom)
    {
        var trongNam = DanhSachGoc.Where(x => x.NgayThi.Year == NamChon).ToList();
        if (trongNam.Count == 0) return new List<ThongKeQuyRow>();

        double TinhGiaTri(IEnumerable<DiemThiItem> items)
        {
            var list = items.ToList();
            if (list.Count == 0) return 0;
            return LaCheDoDiemTB ? Math.Round(list.Average(x => x.TongDiem), 2) : list.Count;
        }

        var rows = trongNam
            .GroupBy(chonNhom)
            .OrderBy(g => g.Key)
            .Select(g => new ThongKeQuyRow(
                g.Key,
                TinhGiaTri(g.Where(x => (x.NgayThi.Month - 1) / 3 + 1 == 1)),
                TinhGiaTri(g.Where(x => (x.NgayThi.Month - 1) / 3 + 1 == 2)),
                TinhGiaTri(g.Where(x => (x.NgayThi.Month - 1) / 3 + 1 == 3)),
                TinhGiaTri(g.Where(x => (x.NgayThi.Month - 1) / 3 + 1 == 4)),
                TinhGiaTri(g),
                false
            ))
            .ToList();

        if (!LaCheDoDiemTB)
        {
            rows.Add(new ThongKeQuyRow(
                "TC (Tổng cộng)",
                rows.Sum(r => r.Q1),
                rows.Sum(r => r.Q2),
                rows.Sum(r => r.Q3),
                rows.Sum(r => r.Q4),
                rows.Sum(r => r.TC),
                true
            ));
        }
        else
        {
            static double TbCoDuLieu(IEnumerable<double> vals)
            {
                var valid = vals.Where(v => v > 0).ToList();
                return valid.Count == 0 ? 0 : Math.Round(valid.Average(), 2);
            }

            rows.Add(new ThongKeQuyRow(
                "TC (Trung bình)",
                TbCoDuLieu(rows.Select(r => r.Q1)),
                TbCoDuLieu(rows.Select(r => r.Q2)),
                TbCoDuLieu(rows.Select(r => r.Q3)),
                TbCoDuLieu(rows.Select(r => r.Q4)),
                TbCoDuLieu(rows.Select(r => r.TC)),
                true
            ));
        }

        return rows;
    }

    private string DinhDangSoQuy(double val) => LaCheDoDiemTB ? val.ToString("0.00") : val.ToString("0");

    // ==================== XUẤT CSV & PDF ====================

    private async Task XuatFileCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("MaBaiThi,MaSV,HoTen,Lop,MaDe,MonHoc,GiangVien,KyThi,NamHoc,NgayThi,SoCauDung,SoCauSai,TongDiem");
        foreach (var r in DanhSachLoc)
        {
            sb.AppendLine($"\"{r.MaBT}\",\"{r.MaSV}\",\"{r.HoTenSV}\",\"{r.Lop}\",\"{r.MaDe}\",\"{r.TenMon}\",\"{r.GiangVien}\",\"{r.KyThi}\",\"{r.NamHoc}\",\"{r.NgayThi:dd/MM/yyyy}\",{r.SoCauDung},{r.SoCauSai},{r.TongDiem.ToString("0.00", CultureInfo.InvariantCulture)}");
        }

        byte[] bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        string base64 = Convert.ToBase64String(bytes);
        string fileName = $"BaoCaoDiemThi_{DateTime.Now:yyyyMMdd_HHmm}.csv";

        await JS.InvokeVoidAsync("eval", $@"
            const link = document.createElement('a');
            link.href = 'data:text/csv;base64,{base64}';
            link.download = '{fileName}';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ");
    }

    private async Task XuatFilePdf()
    {
        var lines = new List<string>
        {
            "BAO CAO THONG KE DIEM THI",
            $"Ngay xuat: {DateTime.Now:dd/MM/yyyy HH:mm} | Tong bai: {DanhSachLoc.Count} | Dat: {SoBaiDat} | Chua dat: {SoBaiChuaDat} | TB: {DiemTrungBinh:0.00}",
            "------------------------------------------------------------------------",
            "Ma BT        | Ma SV    | Lop       | De Thi     | Dung/Sai | Diem",
            "------------------------------------------------------------------------"
        };

        foreach (var r in DanhSachLoc)
        {
            string maBT = BoDauTiengViet(r.MaBT).PadRight(12).Substring(0, 12);
            string maSV = BoDauTiengViet(r.MaSV).PadRight(8).Substring(0, 8);
            string lop = BoDauTiengViet(r.Lop).PadRight(9).Substring(0, 9);
            string maDe = BoDauTiengViet(r.MaDe).PadRight(10).Substring(0, 10);
            string dungSai = $"{r.SoCauDung}/{r.SoCauSai}".PadRight(8);
            string diem = r.TongDiem.ToString("0.00", CultureInfo.InvariantCulture).PadLeft(4);

            lines.Add($"{maBT} | {maSV} | {lop} | {maDe} | {dungSai} | {diem}");
        }

        var streamBuilder = new StringBuilder();
        streamBuilder.AppendLine("BT");
        streamBuilder.AppendLine("/F1 10 Tf");
        streamBuilder.AppendLine("40 760 Td");
        streamBuilder.AppendLine("14 TL");

        for (int i = 0; i < lines.Count; i++)
        {
            string esc = lines[i].Replace("\\", "\\\\").Replace("(", "\\(").Replace(")", "\\)");
            streamBuilder.AppendLine(i == 0 ? $"({esc}) Tj" : $"T* ({esc}) Tj");
        }
        streamBuilder.AppendLine("ET");

        string streamData = streamBuilder.ToString();
        int streamLen = Encoding.ASCII.GetByteCount(streamData);

        var pdf = new StringBuilder();
        var offsets = new List<int> { 0 };

        void AddObj(int id, string body)
        {
            offsets.Add(Encoding.ASCII.GetByteCount(pdf.ToString()));
            pdf.AppendLine($"{id} 0 obj");
            pdf.Append(body);
            if (!body.EndsWith("\n")) pdf.AppendLine();
            pdf.AppendLine("endobj");
        }

        pdf.AppendLine("%PDF-1.4");
        AddObj(1, "<< /Type /Catalog /Pages 2 0 R >>");
        AddObj(2, "<< /Type /Pages /Kids [3 0 R] /Count 1 >>");
        AddObj(3, "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>");
        AddObj(4, "<< /Type /Font /Subtype /Type1 /BaseFont /Courier >>");
        AddObj(5, $"<< /Length {streamLen} >>\nstream\n{streamData}endstream");

        int xrefPos = Encoding.ASCII.GetByteCount(pdf.ToString());
        pdf.AppendLine("xref");
        pdf.AppendLine($"0 {offsets.Count}");
        pdf.AppendLine("0000000000 65535 f ");
        for (int i = 1; i < offsets.Count; i++)
            pdf.AppendLine($"{offsets[i]:D10} 00000 n ");

        pdf.AppendLine("trailer");
        pdf.AppendLine($"<< /Size {offsets.Count} /Root 1 0 R >>");
        pdf.AppendLine("startxref");
        pdf.AppendLine(xrefPos.ToString());
        pdf.Append("%%EOF");

        string base64 = Convert.ToBase64String(Encoding.ASCII.GetBytes(pdf.ToString()));
        string fileName = $"BaoCaoDiemThi_{DateTime.Now:yyyyMMdd_HHmm}.pdf";

        await JS.InvokeVoidAsync("eval", $@"
            const link = document.createElement('a');
            link.href = 'data:application/pdf;base64,{base64}';
            link.download = '{fileName}';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ");
    }

    private static string BoDauTiengViet(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        string normalized = text.Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(normalized.Length);
        foreach (char c in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }
        return sb.ToString().Normalize(NormalizationForm.FormC).Replace('đ', 'd').Replace('Đ', 'D');
    }

    private sealed record DiemThiItem(
        string MaBT,
        string MaSV,
        string HoTenSV,
        string Lop,
        string MaDe,
        string TenMon,
        string GiangVien,
        string KyThi,
        string NamHoc,
        int SoCauDung,
        int SoCauSai,
        double TongDiem,
        DateTime NgayThi);

    private sealed record ThongKeQuyRow(
        string TenDoiTuong,
        double Q1,
        double Q2,
        double Q3,
        double Q4,
        double TC,
        bool LaDongTong);
