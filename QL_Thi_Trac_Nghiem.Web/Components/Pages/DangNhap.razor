@page "/"
@page "/dang-nhap"
@rendermode InteractiveServer
@using QL_Thi_Trac_Nghiem.BUS
@using QL_Thi_Trac_Nghiem.Web.Services
@inject NavigationManager NavManager
@inject PhienDangNhapService PhienDN

<PageTitle>Đăng nhập hệ thống</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card shadow-sm p-4" style="width: 100%; max-width: 420px;">
        <h4 class="text-center fw-bold mb-4">ĐĂNG NHẬP</h4>

        @if (!string.IsNullOrEmpty(thongBaoLoi))
        {
            <div class="alert alert-danger py-2" role="alert">
                @thongBaoLoi
            </div>
        }

        <div class="mb-3 row align-items-center">
            <label class="col-sm-4 col-form-label fw-semibold">Tài khoản:</label>
            <div class="col-sm-8">
                <input type="text" class="form-control" @bind="taiKhoan" @bind:event="oninput"
                       @onkeydown="XuLyPhimEnter" placeholder="Nhập tài khoản" />
            </div>
        </div>

        <div class="mb-4 row align-items-center">
            <label class="col-sm-4 col-form-label fw-semibold">Mật khẩu:</label>
            <div class="col-sm-8">
                <input type="password" class="form-control" @bind="matKhau" @bind:event="oninput"
                       @onkeydown="XuLyPhimEnter" placeholder="Nhập mật khẩu" />
            </div>
        </div>

        <div class="text-center">
            <button type="button" class="btn btn-primary px-4" @onclick="XuLyDangNhap">
                Đăng nhập
            </button>
        </div>
    </div>
</div>

@code {
    private readonly TaiKhoanBUS taiKhoanBUS = new TaiKhoanBUS();

    private string taiKhoan = string.Empty;
    private string matKhau = string.Empty;
    private string thongBaoLoi = string.Empty;

    private void XuLyPhimEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            XuLyDangNhap();
        }
    }

    private void XuLyDangNhap()
    {
        thongBaoLoi = string.Empty;

        string tk = taiKhoan.Trim();
        string mk = matKhau.Trim();

        if (string.IsNullOrEmpty(tk) || string.IsNullOrEmpty(mk))
        {
            thongBaoLoi = "Vui lòng nhập đầy đủ Tài khoản và Mật khẩu!";
            return;
        }

        try
        {
            string loaiTaiKhoan = taiKhoanBUS.KiemTraDangNhap(tk, mk)?.Trim() ?? "";

            if (loaiTaiKhoan == "AD")
            {
                PhienDN.DangNhapThanhCong(tk, "AD");
                NavManager.NavigateTo("/admin-nhan-su");
            }
            else if (loaiTaiKhoan == "GV")
            {
                PhienDN.DangNhapThanhCong(tk, "GV");
                NavManager.NavigateTo("/giao-vien");
            }
            else if (loaiTaiKhoan == "TS" || loaiTaiKhoan == "SV")
            {
                PhienDN.DangNhapThanhCong(tk, loaiTaiKhoan);
                NavManager.NavigateTo("/sinh-vien");
            }
            else
            {
                thongBaoLoi = $"Tài khoản hoặc mật khẩu không chính xác! (Quyền trả về: '{loaiTaiKhoan}')";
            }
        }
        catch (Exception ex)
        {
            thongBaoLoi = "Lỗi hệ thống khi đăng nhập: " + ex.Message;
        }
    }
}
