@page "/ky-thi"
@rendermode InteractiveServer
@using System.Data
@using QL_Thi_Trac_Nghiem.BUS
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Quản lý Kỳ thi (Web Blazor)</PageTitle>

<div class="container-fluid py-3">
    <h3 class="text-primary fw-bold mb-3">QUẢN LÝ KỲ THI</h3>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(laLoi ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    <!-- THÔNG TIN KỲ THI -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light fw-bold">Thông tin kỳ thi</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Mã kỳ thi:</label>
                    <input class="form-control" @bind="maKT" readonly="@dangSua" placeholder="VD: KT01" />
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Tên kỳ thi:</label>
                    <input class="form-control" @bind="tenKT" placeholder="Nhập tên kỳ thi" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Ngày thi:</label>
                    <input type="date" class="form-control" @bind="ngayThi" />
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="LuuKyThi" disabled="@dangSua">Thêm</button>
                <button class="btn btn-warning" @onclick="LuuKyThi" disabled="@(!dangSua)">Cập nhật</button>
                <button class="btn btn-danger" @onclick="YeuCauXoa" disabled="@(!dangSua)">Xóa</button>
                <button class="btn btn-secondary" @onclick="LamMoi">Làm mới</button>
            </div>

            @if (hoiXacNhanXoa)
            {
                <div class="alert alert-warning mt-3 mb-0 d-flex flex-wrap align-items-center gap-2">
                    <span class="me-2">Bạn có chắc muốn xóa kỳ thi '<strong>@maDangChon</strong>' không?</span>
                    <button class="btn btn-sm btn-danger" @onclick="XacNhanXoa">Có, xóa</button>
                    <button class="btn btn-sm btn-secondary" @onclick="() => hoiXacNhanXoa = false">Hủy</button>
                </div>
            }
        </div>
    </div>

    <!-- TÌM KIẾM -->
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <input class="form-control" style="max-width: 320px;" @bind="tuKhoa" @bind:event="oninput"
               @onkeydown="XuLyPhimEnter" placeholder="Tìm theo mã hoặc tên kỳ thi..." />
        <button class="btn btn-info text-white" @onclick="TimKiem">Tìm kiếm</button>
    </div>

    <!-- DANH SÁCH KỲ THI -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white fw-bold">
            Danh sách Kỳ thi (Click vào 1 dòng để Sửa / Xóa)
        </div>
        <div class="card-body p-0 table-responsive" style="max-height: 420px;">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-secondary sticky-top">
                    <tr>
                        <th>Mã kỳ thi</th>
                        <th>Tên kỳ thi</th>
                        <th>Ngày thi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (dsKyThiHienThi.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-3">Chưa có dữ liệu kỳ thi.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var kt in dsKyThiHienThi)
                        {
                            <tr class="@(maDangChon == kt.MaKT ? "table-primary fw-bold" : "")"
                                style="cursor:pointer" @onclick="() => ChonKyThi(kt)">
                                <td>@kt.MaKT</td>
                                <td>@kt.Ten</td>
                                <td>@kt.NgayThi.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private readonly ExamConfigBUS _bus = new ExamConfigBUS();

    private List<KyThiItem> dsKyThiGoc = new();
    private List<KyThiItem> dsKyThiHienThi = new();

    private string maKT = "";
    private string tenKT = "";
    private DateTime ngayThi = DateTime.Today;

    private string maDangChon = "";
    private bool dangSua = false;
    private bool hoiXacNhanXoa = false;
    private string tuKhoa = "";

    private string thongBao = "";
    private bool laLoi = false;

    protected override void OnInitialized()
    {
        TaiDanhSachKyThi();
    }

    private void TaiDanhSachKyThi()
    {
        DataTable dt = _bus.LayDanhSachKyThi();
        dsKyThiGoc = new List<KyThiItem>();

        foreach (DataRow row in dt.Rows)
        {
            string ma = row["Ma_KT"]?.ToString()?.Trim() ?? "";
            string ten = row["Ten"]?.ToString()?.Trim() ?? "";
            DateTime d = DateTime.TryParse(row["Ngay_thi"]?.ToString(), out DateTime parsed) ? parsed : DateTime.Today;
            dsKyThiGoc.Add(new KyThiItem(ma, ten, d));
        }

        dsKyThiHienThi = new List<KyThiItem>(dsKyThiGoc);
        XoaTrangPhanNhap();
    }

    private void XoaTrangPhanNhap()
    {
        maDangChon = "";
        dangSua = false;
        hoiXacNhanXoa = false;
        maKT = "";
        tenKT = "";
        ngayThi = DateTime.Today;
    }

    private void LamMoi()
    {
        tuKhoa = "";
        thongBao = "";
        TaiDanhSachKyThi();
    }

    private void ChonKyThi(KyThiItem kt)
    {
        dangSua = true;
        maDangChon = kt.MaKT;
        maKT = kt.MaKT;
        tenKT = kt.Ten;
        ngayThi = kt.NgayThi;
        thongBao = "";
        hoiXacNhanXoa = false;
    }

    private void LuuKyThi()
    {
        if (string.IsNullOrWhiteSpace(maKT) || string.IsNullOrWhiteSpace(tenKT))
        {
            laLoi = true;
            thongBao = "Vui lòng nhập đầy đủ Mã kỳ thi và Tên kỳ thi!";
            return;
        }

        var res = _bus.LuuKyThi(maKT.Trim(), tenKT.Trim(), ngayThi.Date, dangSua);
        laLoi = !res.ok;
        thongBao = res.msg;

        if (res.ok)
        {
            TaiDanhSachKyThi();
            thongBao = res.msg;
        }
    }

    private void YeuCauXoa()
    {
        if (string.IsNullOrWhiteSpace(maDangChon))
        {
            laLoi = true;
            thongBao = "Vui lòng chọn kỳ thi trong danh sách trước khi xóa!";
            return;
        }
        hoiXacNhanXoa = true;
    }

    private void XacNhanXoa()
    {
        hoiXacNhanXoa = false;
        var res = _bus.XoaKyThiAnToan(maDangChon.Trim());
        laLoi = !res.ok;
        thongBao = res.msg;

        if (res.ok)
        {
            TaiDanhSachKyThi();
            thongBao = res.msg;
        }
    }

    private void TimKiem()
    {
        string key = (tuKhoa ?? "").Trim();
        if (string.IsNullOrEmpty(key))
        {
            dsKyThiHienThi = new List<KyThiItem>(dsKyThiGoc);
            return;
        }

        dsKyThiHienThi = dsKyThiGoc.Where(x =>
            x.MaKT.Contains(key, StringComparison.OrdinalIgnoreCase) ||
            x.Ten.Contains(key, StringComparison.OrdinalIgnoreCase)).ToList();

        XoaTrangPhanNhap();
        if (dsKyThiHienThi.Count == 0)
        {
            laLoi = false;
            thongBao = "Không tìm thấy kỳ thi nào phù hợp!";
        }
    }

    private void XuLyPhimEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") TimKiem();
    }

    private sealed record KyThiItem(string MaKT, string Ten, DateTime NgayThi);
}
