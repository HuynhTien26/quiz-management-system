@page "/ma-tran-de"
@rendermode InteractiveServer
@using System.Data
@using QL_Thi_Trac_Nghiem.BUS
@using QL_Thi_Trac_Nghiem.DAO
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Thiết lập Ma trận Đề thi (Web Blazor)</PageTitle>

<div class="container-fluid py-3">
    <h3 class="text-primary fw-bold mb-3">THIẾT LẬP MA TRẬN ĐỀ THI</h3>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(laLoi ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    <!-- KHU VỰC NHẬP LIỆU MA TRẬN -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light fw-bold">Thông tin Ma trận Đề thi</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Mã ma trận:</label>
                    <input class="form-control" @bind="maMT" readonly="@dangSua" placeholder="VD: MT01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Môn học:</label>
                    <select class="form-select" @bind="maMon">
                        <option value="">-- Chọn môn học --</option>
                        @foreach (var m in dsMon)
                        {
                            <option value="@m.MaMon">@m.MaMon - @m.TenMon</option>
                        }
                    </select>
                </div>
                <div class="col-md-5 d-flex align-items-end">
                    <span class="fs-5 fw-bold @(HopLeTyLe ? "text-success" : "text-danger")">
                        Tổng tỷ lệ: @TongTyLe% @(HopLeTyLe ? "(Hợp lệ)" : "(Phải bằng 100%)")
                    </span>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">% Cơ bản:</label>
                    <input type="number" min="0" max="100" step="1" class="form-control"
                           @bind="tyLeCoBan" @bind:event="oninput" placeholder="Nhập %" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">% Vận dụng:</label>
                    <input type="number" min="0" max="100" step="1" class="form-control"
                           @bind="tyLeVanDung" @bind:event="oninput" placeholder="Nhập %" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">% Vận dụng cao:</label>
                    <input type="number" min="0" max="100" step="1" class="form-control"
                           @bind="tyLeVDNangCao" @bind:event="oninput" placeholder="Nhập %" />
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="LuuMaTran" disabled="@(dangSua || !HopLeTyLe)">Thêm</button>
                <button class="btn btn-warning" @onclick="LuuMaTran" disabled="@(!dangSua || !HopLeTyLe)">Cập nhật</button>
                <button class="btn btn-danger" @onclick="YeuCauXoa" disabled="@(!dangSua)">Xóa</button>
                <button class="btn btn-secondary" @onclick="LamMoi">Làm mới</button>
            </div>

            @if (hoiXacNhanXoa)
            {
                <div class="alert alert-warning mt-3 mb-0 d-flex flex-wrap align-items-center gap-2">
                    <span class="me-2">Bạn có chắc muốn xóa ma trận '<strong>@maDangChon</strong>' không?</span>
                    <button class="btn btn-sm btn-danger" @onclick="XacNhanXoa">Có, xóa</button>
                    <button class="btn btn-sm btn-secondary" @onclick="() => hoiXacNhanXoa = false">Hủy</button>
                </div>
            }
        </div>
    </div>

    <!-- TÌM KIẾM -->
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <input class="form-control" style="max-width: 320px;" @bind="tuKhoa" @bind:event="oninput"
               @onkeydown="XuLyPhimEnter" placeholder="Tìm theo mã ma trận hoặc môn học..." />
        <button class="btn btn-info text-white" @onclick="TimKiem">Tìm kiếm</button>
    </div>

    <!-- DANH SÁCH MA TRẬN -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white fw-bold">
            Danh sách Ma trận Đề thi (Click vào 1 dòng để Sửa / Xóa)
        </div>
        <div class="card-body p-0 table-responsive" style="max-height: 420px;">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-secondary sticky-top">
                    <tr>
                        <th>Mã ma trận</th>
                        <th>Môn học</th>
                        <th class="text-center">% Cơ bản</th>
                        <th class="text-center">% Vận dụng</th>
                        <th class="text-center">% Vận dụng cao</th>
                    </tr>
                </thead>
                <tbody>
                    @if (dsMaTranHienThi.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Chưa có dữ liệu ma trận đề thi.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var mt in dsMaTranHienThi)
                        {
                            <tr class="@(maDangChon == mt.MaMT ? "table-primary fw-bold" : "")"
                                style="cursor:pointer" @onclick="() => ChonMaTran(mt)">
                                <td>@mt.MaMT</td>
                                <td>@mt.HienThiMon</td>
                                <td class="text-center">@mt.TyLeCoBan%</td>
                                <td class="text-center">@mt.TyLeVanDung%</td>
                                <td class="text-center">@mt.TyLeVDNangCao%</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private readonly ExamConfigBUS _bus = new ExamConfigBUS();

    private List<MonOption> dsMon = new();
    private List<MaTranItem> dsMaTranGoc = new();
    private List<MaTranItem> dsMaTranHienThi = new();

    private string maMT = "";
    private string maMon = "";
    private double? tyLeCoBan = null;
    private double? tyLeVanDung = null;
    private double? tyLeVDNangCao = null;

    private string maDangChon = "";
    private bool dangSua = false;
    private bool hoiXacNhanXoa = false;
    private string tuKhoa = "";

    private string thongBao = "";
    private bool laLoi = false;

    private double TongTyLe => Math.Round((tyLeCoBan ?? 0) + (tyLeVanDung ?? 0) + (tyLeVDNangCao ?? 0), 2);

    private bool HopLeTyLe =>
        tyLeCoBan.HasValue && tyLeVanDung.HasValue && tyLeVDNangCao.HasValue &&
        tyLeCoBan >= 0 && tyLeVanDung >= 0 && tyLeVDNangCao >= 0 &&
        Math.Abs(TongTyLe - 100) < 0.001;

    protected override void OnInitialized()
    {
        TaiDanhSachMon();
        TaiDanhSachMaTran();
    }

    private void TaiDanhSachMon()
    {
        dsMon.Clear();
        DataTable dtMon = DataProvider.Instance.ExecuteQuery("SELECT Ma_Mon, Ten_mon FROM Mon");
        foreach (DataRow r in dtMon.Rows)
        {
            string id = r["Ma_Mon"]?.ToString()?.Trim() ?? "";
            string name = r["Ten_mon"]?.ToString()?.Trim() ?? id;
            dsMon.Add(new MonOption(id, name));
        }
    }

    private void TaiDanhSachMaTran()
    {
        DataTable dt = _bus.LayDanhSachMaTran();
        dsMaTranGoc = new List<MaTranItem>();

        foreach (DataRow row in dt.Rows)
        {
            string idMT = row["Ma_MT"]?.ToString()?.Trim() ?? "";
            string idMon = row["Ma_Mon"]?.ToString()?.Trim() ?? "";
            string tenMon = dt.Columns.Contains("Ten_mon") && row["Ten_mon"] != DBNull.Value
                ? row["Ten_mon"]?.ToString()?.Trim() ?? idMon
                : (dsMon.FirstOrDefault(m => m.MaMon == idMon)?.TenMon ?? idMon);

            double cb = Convert.ToDouble(row["Ty_le_co_ban"] == DBNull.Value ? 0 : row["Ty_le_co_ban"]);
            double vd = Convert.ToDouble(row["Ty_le_van_dung"] == DBNull.Value ? 0 : row["Ty_le_van_dung"]);
            double vdnc = Convert.ToDouble(row["Ty_le_vd_nang_cao"] == DBNull.Value ? 0 : row["Ty_le_vd_nang_cao"]);

            dsMaTranGoc.Add(new MaTranItem(idMT, idMon, tenMon, cb, vd, vdnc));
        }

        dsMaTranHienThi = new List<MaTranItem>(dsMaTranGoc);
        XoaTrangPhanNhap();
    }

    private void XoaTrangPhanNhap()
    {
        maDangChon = "";
        dangSua = false;
        hoiXacNhanXoa = false;
        maMT = "";
        maMon = "";
        tyLeCoBan = null;
        tyLeVanDung = null;
        tyLeVDNangCao = null;
    }

    private void LamMoi()
    {
        tuKhoa = "";
        thongBao = "";
        TaiDanhSachMaTran();
    }

    private void ChonMaTran(MaTranItem mt)
    {
        dangSua = true;
        maDangChon = mt.MaMT;
        maMT = mt.MaMT;
        maMon = mt.MaMon;
        tyLeCoBan = mt.TyLeCoBan;
        tyLeVanDung = mt.TyLeVanDung;
        tyLeVDNangCao = mt.TyLeVDNangCao;
        thongBao = "";
        hoiXacNhanXoa = false;
    }

    private void LuuMaTran()
    {
        if (string.IsNullOrWhiteSpace(maMT) || string.IsNullOrWhiteSpace(maMon))
        {
            laLoi = true;
            thongBao = "Vui lòng nhập Mã ma trận và chọn Môn học!";
            return;
        }

        if (!tyLeCoBan.HasValue || !tyLeVanDung.HasValue || !tyLeVDNangCao.HasValue || !HopLeTyLe)
        {
            laLoi = true;
            thongBao = "Vui lòng nhập đầy đủ cả 3 tỷ lệ phần trăm độ khó và đảm bảo tổng bằng 100%.";
            return;
        }

        var res = _bus.LuuMaTran(
            maMT.Trim(),
            maMon.Trim(),
            tyLeCoBan.Value,
            tyLeVanDung.Value,
            tyLeVDNangCao.Value);

        laLoi = !res.ok;
        thongBao = res.msg;

        if (res.ok)
        {
            TaiDanhSachMaTran();
            thongBao = res.msg;
        }
    }

    private void YeuCauXoa()
    {
        if (string.IsNullOrWhiteSpace(maDangChon))
        {
            laLoi = true;
            thongBao = "Vui lòng chọn ma trận trong danh sách trước khi xóa!";
            return;
        }
        hoiXacNhanXoa = true;
    }

    private void XacNhanXoa()
    {
        hoiXacNhanXoa = false;
        bool ok = _bus.XoaMaTran(maDangChon.Trim());
        laLoi = !ok;
        thongBao = ok ? $"Đã xóa ma trận '{maDangChon}'." : "Xóa ma trận thất bại (có thể ma trận đang được đề thi sử dụng).";

        if (ok)
        {
            TaiDanhSachMaTran();
            thongBao = "Đã xóa ma trận.";
        }
    }

    private void TimKiem()
    {
        string key = (tuKhoa ?? "").Trim();
        if (string.IsNullOrEmpty(key))
        {
            dsMaTranHienThi = new List<MaTranItem>(dsMaTranGoc);
            return;
        }

        dsMaTranHienThi = dsMaTranGoc.Where(x =>
            x.MaMT.Contains(key, StringComparison.OrdinalIgnoreCase) ||
            x.MaMon.Contains(key, StringComparison.OrdinalIgnoreCase) ||
            x.TenMon.Contains(key, StringComparison.OrdinalIgnoreCase)).ToList();

        XoaTrangPhanNhap();
        if (dsMaTranHienThi.Count == 0)
        {
            laLoi = false;
            thongBao = "Không tìm thấy ma trận nào phù hợp!";
        }
    }

    private void XuLyPhimEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") TimKiem();
    }

    private sealed record MonOption(string MaMon, string TenMon);

    private sealed record MaTranItem(
        string MaMT,
        string MaMon,
        string TenMon,
        double TyLeCoBan,
        double TyLeVanDung,
        double TyLeVDNangCao)
    {
        public string HienThiMon => MaMon == TenMon ? MaMon : $"{TenMon} ({MaMon})";
    }
}
