@implements IDisposable
@using QL_Thi_Trac_Nghiem.Web.Services
@inject PhienDangNhapService PhienDN
@inject NavigationManager NavManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">QL Thi Trắc Nghiệm</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <!-- Menu chung -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <!-- Menu phân quyền Giáo viên (và Admin) -->
        @if (PhienDN.DaDangNhap && (PhienDN.LaGiaoVien || PhienDN.LaAdmin))
        {
            <hr class="text-white-50 mx-3 my-2" />

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="giao-vien">
                    <span class="bi bi-person-badge-fill" aria-hidden="true"></span> Khu vực Giáo viên
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="mon-hoc">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Quản lý Môn học
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="ky-thi">
                    <span class="bi bi-calendar-event-fill" aria-hidden="true"></span> Quản lý Kỳ thi
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="ma-tran-de">
                    <span class="bi bi-grid-3x3-gap-fill" aria-hidden="true"></span> Ma trận Đề thi
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="tao-de-thi">
                    <span class="bi bi-file-earmark-plus-fill" aria-hidden="true"></span> Tạo Đề thi
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="quan-ly-de-thi">
                    <span class="bi bi-journal-text" aria-hidden="true"></span> Quản lý Đề thi
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="bao-cao-diem">
                    <span class="bi bi-bar-chart-line-fill" aria-hidden="true"></span> Báo cáo điểm
                </NavLink>
            </div>
        }

        <!-- Menu phân quyền Admin -->
        @if (PhienDN.DaDangNhap && PhienDN.LaAdmin)
        {
            <hr class="text-white-50 mx-3 my-2" />

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin-nhan-su">
                    <span class="bi bi-people-fill" aria-hidden="true"></span> Quản lý Nhân sự
                </NavLink>
            </div>
        }

        <!-- Nút Đăng xuất chung khi đã đăng nhập -->
        @if (PhienDN.DaDangNhap)
        {
            <hr class="text-white-50 mx-3 my-2" />

            <div class="nav-item px-3 mt-1">
                <button type="button" class="btn btn-light fw-semibold w-100" @onclick="DangXuat">
                    Đăng xuất
                </button>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        PhienDN.OnChange += HandleStateChange;
    }

    private void HandleStateChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void DangXuat()
    {
        PhienDN.DangXuat();
        NavManager.NavigateTo("/");
    }

    public void Dispose()
    {
        PhienDN.OnChange -= HandleStateChange;
    }
}